# Postgres (local Homebrew: createdb zuko)
DATABASE_URL="postgresql://USER@localhost:5432/zuko"
# Optional: enables the database-backed backend tests. Use a database of their own, never the
# one you develop in or the e2e one (zuko_test): the tests create and delete rows.
#   createdb zuko_unit_test && DATABASE_URL=postgresql://USER@localhost:5432/zuko_unit_test \
#     pnpm --filter @zuko/backend exec prisma migrate deploy
# TEST_DATABASE_URL="postgresql://USER@localhost:5432/zuko_unit_test"

# better-auth (generate a secret with: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
BACKEND_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:4200"
# Backend/harness service credential (at least 32 bytes). Authorizes token minting.
# Generate independently from BETTER_AUTH_SECRET; the backend alone signs tokens.
EVE_AUTH_SECRET=""
# Backend only: temporary old key during rotation; remove after harness rollout.
# EVE_AUTH_SECRET_PREVIOUS=""
# Optional backend socket-peer allowlist; configure private ingress too, never trust X-Forwarded-For here.
# HARNESS_ALLOWED_IPS="127.0.0.1,::1"
# AI Gateway is the default model route; a direct provider can be configured in agent/agent.ts.
AI_GATEWAY_API_KEY=""
# Optional Google sign-in
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Next.js app
NEXT_PUBLIC_BACKEND_URL="http://localhost:3000"

# Workflow SDK: durable Postgres storage (defaults to DATABASE_URL).
# This may point to a separate database. Run bootstrap against this URL before starting:
#   node --env-file-if-exists=.env node_modules/@workflow/world-postgres/bin/setup.js
# WORKFLOW_POSTGRES_URL="postgresql://USER@localhost:5432/zuko"
WORKFLOW_POSTGRES_JOB_LOCK_STALE_SECONDS=30
WORKFLOW_POSTGRES_WORKER_CONCURRENCY=5

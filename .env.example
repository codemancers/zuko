# Postgres (local Homebrew: createdb zuko)
DATABASE_URL="postgresql://USER@localhost:5432/zuko"
# Optional: enables the database-backed backend tests. Use a database of their own, never the
# one you develop in or the e2e one (zuko_test): the tests create and delete rows.
#   createdb zuko_unit_test && DATABASE_URL=postgresql://USER@localhost:5432/zuko_unit_test \
#     pnpm --filter @zuko/backend exec prisma migrate deploy
# TEST_DATABASE_URL="postgresql://USER@localhost:5432/zuko_unit_test"

# better-auth (generate a secret with: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
BACKEND_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:4200"
# Optional Google sign-in
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Next.js app
NEXT_PUBLIC_BACKEND_URL="http://localhost:3000"

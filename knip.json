{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["flyctl", "fly", "oxlint", "knip"],
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.{ts,js}"],
      "project": ["scripts/**/*.{ts,js}"],
      "ignoreDependencies": [
        "tslib",
        "@nx/nest",
        "@nx/node",
        "@nx/vite",
        "@nx/web",
        "@nx/workspace",
        "@nestjs/schematics",
        "socket.io-client",
        "ws",
        "@aws-sdk/client-s3",
        "@deepgram/sdk",
        "@heroicons/react",
        "@nestjs/config",
        "@thallesp/nestjs-better-auth",
        "@types/jsonwebtoken",
        "joi",
        "jsonwebtoken",
        "puppeteer-core",
        "puppeteer-extra",
        "puppeteer-extra-plugin-stealth",
        "puppeteer-stream",
        "simple-git",
        "@babel/core",
        "@babel/preset-react",
        "@eslint/js",
        "eslint-config-next",
        "eslint-plugin-import",
        "eslint-plugin-jsx-a11y",
        "eslint-plugin-react",
        "eslint-plugin-react-hooks",
        "typescript-eslint",
        "@types/bcrypt",
        "@types/ws",
        "ajv",
        "bcrypt"
      ]
    },
    "apps/web": {
      "entry": [
        "src/app/**/page.{ts,tsx}",
        "src/app/**/layout.{ts,tsx}",
        "src/app/**/route.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": [
        "shiki"
      ]
    },
    "apps/backend": {
      "entry": ["src/main.ts"],
      "project": ["src/**/*.ts"],
      "webpack": false
    },
    "apps/ai-agents": {
      "entry": [
        "src/agents/index.ts",
        "src/main.ts"
      ],
      "project": ["src/**/*.ts"]
    },
    "libs/core": {
      "project": ["src/**/*.ts"]
    },
    "libs/models": {
      "project": ["src/**/*.ts"]
    },
    "libs/sales": {
      "project": ["src/**/*.ts"]
    }
  },
  "ignore": [
    "apps/**-e2e/**",
    "libs/ui-kit/**"
  ]
}

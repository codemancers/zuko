{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["flyctl", "fly", "oxlint"],
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.{ts,js}"],
      "project": ["scripts/**/*.{ts,js}"],
      "ignoreDependencies": [
        "tslib",
        "@swc/jest",
        "jest-environment-node",
        "jest-util",
        "@nx/nest",
        "@nx/node",
        "@nx/vite",
        "@nx/web",
        "@nx/workspace",
        "@nestjs/schematics",
        "reflect-metadata",
        "rxjs",
        "socket.io-client",
        "ws",
        "@aws-sdk/client-s3",
        "@deepgram/sdk",
        "@heroicons/react",
        "@nestjs/config",
        "@thallesp/nestjs-better-auth",
        "@types/jsonwebtoken",
        "joi",
        "jsonwebtoken",
        "puppeteer-core",
        "puppeteer-extra",
        "puppeteer-extra-plugin-stealth",
        "puppeteer-stream",
        "simple-git"
      ]
    },
    "apps/web": {
      "entry": [
        "src/app/**/page.{ts,tsx}",
        "src/app/**/layout.{ts,tsx}",
        "src/app/**/route.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/backend": {
      "entry": ["src/main.ts"],
      "project": ["src/**/*.ts"],
      "webpack": false
    },
    "apps/ai-agents": {
      "entry": ["src/main.ts"],
      "project": ["src/**/*.ts"]
    },
    "libs/core": {
      "project": ["src/**/*.ts"]
    },
    "libs/models": {
      "project": ["src/**/*.ts"]
    },
    "libs/sales": {
      "project": ["src/**/*.ts"]
    }
  },
  "ignore": [
    "apps/**-e2e/**",
    "libs/ui-kit/**"
  ]
}

# Use a database separate from Zuko's application database.
DATABASE_URL=postgresql://USER@localhost:5432/zuko_connect

# Generate with: openssl rand -hex 32
KOSHA_SECRET=

# Generate with: openssl rand -base64 32
# Keep this stable: it encrypts Apollo API keys at rest.
KOSHA_ENCRYPTION_KEY=

# The server fronts the admin UI and the API from this one public origin.
KOSHA_PUBLIC_URL=http://localhost:3333
PORT=3333

# Internal admin process. It is proxied by PORT and normally is not published.
ADMIN_PORT=3000
# ADMIN_URL=https://connect.example.com

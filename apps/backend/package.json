{
  "name": "@zuko/backend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "pin:dist-versions": "tsx scripts/pin-dist-versions.ts",
    "provision:agent-host": "tsx scripts/provision-agent-host.ts"
  },
  "type": "module",
  "dependencies": {
    "@ai-sdk/openai": "^4.0.17",
    "@auth/agent": "^0.4.5",
    "@better-auth/agent-auth": "^0.4.5",
    "@better-auth/oauth-provider": "1.6.22",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nangohq/node": "^0.70.9",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.3",
    "@nestjs/websockets": "^11.0.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@thallesp/nestjs-better-auth": "^2.5.1",
    "@zuko/core": "workspace:*",
    "@zuko/models": "workspace:*",
    "@zuko/sales": "workspace:*",
    "ai": "^6.0.70",
    "axios": "^1.6.0",
    "better-auth": "1.6.22",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dayjs": "^1.11.19",
    "graphql": "^16.12.0",
    "joi": "^17.13.3",
    "pg": "^8.16.3",
    "prisma": "^7.7.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "socket.io": "^4.8.0",
    "swagger-ui-express": "^5.0.1",
    "tslib": "^2.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "apps/backend/dist",
          "main": "apps/backend/src/main.ts",
          "tsConfig": "apps/backend/tsconfig.app.json",
          "assets": [
            "apps/backend/src/assets",
            {
              "input": "apps/backend",
              "glob": "package.json",
              "output": "."
            }
          ],
          "platform": "node",
          "bundle": true,
          "format": [
            "esm"
          ],
          "esbuildConfig": "apps/backend/esbuild.config.cjs"
        },
        "configurations": {
          "development": {
            "minify": false,
            "sourcemap": true
          },
          "production": {
            "minify": true,
            "sourcemap": false,
            "esbuildOptions": {
              "keepNames": true
            }
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build",
          "copy-workspace-modules"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/backend/dist/package.json",
          "{workspaceRoot}/apps/backend/dist/pnpm-workspace.yaml"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/backend/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "pin-dist-versions": {
        "dependsOn": [
          "prune-lockfile"
        ],
        "executor": "nx:run-commands",
        "options": {
          "command": "pnpm run pin:dist-versions",
          "cwd": "apps/backend"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules",
          "pin-dist-versions"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@zuko/backend:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@zuko/backend:build:development"
          },
          "production": {
            "buildTarget": "@zuko/backend:build:production"
          }
        }
      },
      "test": {
        "executor": "@nx/vitest:test",
        "outputs": [
          "{projectRoot}/test-output/vitest/coverage"
        ],
        "options": {
          "configFile": "apps/backend/vitest.config.ts"
        }
      },
      "docker:build": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build",
          "prune"
        ],
        "options": {
          "command": "export FLY_APP=$(grep '^app = ' apps/backend/fly.toml | cut -d \"'\" -f 2) && export GIT_SHA=$(git rev-parse --short HEAD) && docker build --platform linux/amd64 -f apps/backend/Dockerfile -t registry.fly.io/$FLY_APP:$GIT_SHA ."
        }
      },
      "deploy": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "docker:build"
        ],
        "options": {
          "command": "export FLY_APP=$(grep '^app = ' apps/backend/fly.toml | cut -d \"'\" -f 2) && export GIT_SHA=$(git rev-parse --short HEAD) && flyctl auth docker && docker push registry.fly.io/$FLY_APP:$GIT_SHA && fly deploy --image registry.fly.io/$FLY_APP:$GIT_SHA -c apps/backend/fly.toml"
        }
      }
    }
  },
  "_comment_graphql": "graphql is a peer dependency of @thallesp/nestjs-better-auth, installed here to avoid runtime errors"
}

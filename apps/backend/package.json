{
  "name": "@zuko/backend",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "@better-auth/cimd": "^1.7.25",
    "@better-auth/oauth-provider": "^1.7.25",
    "@better-auth/prisma-adapter": "^1.7.25",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "7.10.1",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "@workflow/nest": "5.1.13",
    "@workflow/world-postgres": "5.5.0",
    "@zuko/access-control": "workspace:*",
    "@zuko/better-auth-audit": "workspace:*",
    "@zuko/better-auth-hierarchy": "workspace:*",
    "better-auth": "^1.7.25",
    "dotenv": "^18.0.10",
    "file-type": "21.3.4",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0",
    "workflow": "5.8.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.1"
  },
  "nx": {
    "targets": {
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/pnpm-workspace.yaml",
          "{workspaceRoot}/package.json",
          {
            "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
          }
        ],
        "outputs": [
          "{workspaceRoot}/apps/backend/dist/package.json",
          "{workspaceRoot}/apps/backend/dist/pnpm-lock.yaml",
          "{workspaceRoot}/apps/backend/dist/pnpm-workspace.yaml",
          "{workspaceRoot}/apps/backend/dist/patches",
          "{workspaceRoot}/apps/backend/dist/local_path_modules"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/backend/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "readyWhen": {
          "signal": true
        },
        "options": {
          "buildTarget": "@zuko/backend:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@zuko/backend:build:development"
          },
          "production": {
            "buildTarget": "@zuko/backend:build:production"
          }
        }
      },
      "docker:build": {
        "dependsOn": [
          "build",
          "prune"
        ]
      },
      "prisma-generate": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/prisma/schema.prisma",
          "{projectRoot}/prisma.config.ts"
        ],
        "outputs": [
          "{projectRoot}/src/generated/prisma"
        ],
        "options": {
          "command": "prisma generate",
          "cwd": "{projectRoot}"
        }
      },
      "build": {
        "dependsOn": [
          "^build",
          "prisma-generate"
        ],
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "webpack-cli build --config-node-env=production",
            "node tools/build-workflows.mjs"
          ],
          "cwd": "apps/backend",
          "parallel": false
        },
        "outputs": [
          "{projectRoot}/dist"
        ]
      }
    }
  },
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  }
}

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/zuko_dev

# ── Auth ──────────────────────────────────────────────────────────────────────
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:3001
BACKEND_URL=http://localhost:3001

# GitHub OAuth (required for user login)
# https://github.com/settings/developers → New OAuth App
# Callback URL: http://localhost:3001/api/auth/callback/github
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_APP_SLUG=zuko
# OpenAI API Key (required)
OPENAI_API_KEY=your-openai-api-key

# LLM Model (optional, defaults to gpt-4o)
AGENTS_LLM_MODEL=gpt-4o

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Zuko

# Google OAuth 2.0 Credentials (required for secretary agent)
# Get these from https://console.cloud.google.com/
# 1. Create a project
# 2. Enable Google Calendar API and People API
# 3. Create OAuth 2.0 credentials (Desktop app type)
# 4. Download and add client ID and secret here
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3333/oauth/callback

# Database URL (required for checkpointing)
DATABASE_URL=postgresql://user:password@localhost:5432/agents

# Auth configuration
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:3001
BACKEND_URL=http://localhost:3001

# Email/Password Authentication (optional, for testing purposes)
# Set to "true" to enable email/password authentication
# By default, only Google OAuth is enabled
# Email/password auth (optional, for local testing)
BETTER_AUTH_INCLUDE_EMAILS_AUTH=false

# ── Agent (in-process deepagents) ─────────────────────────────────────────────
# Model to use for the chat agent. Prefix with provider: openai/, anthropic/
# Examples: openai/gpt-4.1  anthropic/claude-sonnet-4-5-20250929
AGENT_MODEL=openai/gpt-4.1

# OpenAI API key (required when AGENT_MODEL starts with openai/)
OPENAI_API_KEY=your-openai-api-key

# Specific OpenAI model name (used when AGENT_MODEL is not set, defaults to gpt-4.1)
OPENAI_MODEL=gpt-4.1

# ── Sprites (Fly sandbox) ─────────────────────────────────────────────────────
# Set to "false" to use LocalSandbox (Node.js fs/child_process) for local dev.
# When true, a Fly Sprite is created per chat and tools run inside it.
SPRITES_ENABLED=false

# Required when SPRITES_ENABLED=true
SPRITES_TOKEN=
SPRITES_API_BASE_URL=https://sprites.fly.dev

# Git branch to clone into the sprite on first setup
AGENT_BRANCH=main

# Working directory inside the sprite (or local path for LocalSandbox)
WORKING_DIR=/home/sprite/zuko

# ── E2E / Testing ─────────────────────────────────────────────────────────────
E2E_SANDBOX=
E2E_SANDBOX_URL=

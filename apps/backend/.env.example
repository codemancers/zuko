# ── Core ──────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/zuko_dev
BACKEND_URL=http://localhost:3001
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:3001

# Google (required for calendar/people agents)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3333/oauth/callback

# Enable email/password login for local testing
BETTER_AUTH_INCLUDE_EMAILS_AUTH=false

# ── AI & Agents ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key

# Models (Prefix with provider: openai/, anthropic/)
AGENT_MODEL=openai/gpt-4o
AGENTS_LLM_MODEL=gpt-4o
OPENAI_MODEL=gpt-4o

# LangSmith Tracing
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Zuko

# ── Sprites (Fly sandbox) ─────────────────────────────────────────────────────
SPRITES_ENABLED=false
SPRITES_TOKEN=
SPRITES_API_BASE_URL=https://sprites.fly.dev
AGENT_BRANCH=main
WORKING_DIR=/home/sprite/zuko

# ── E2E / Testing ─────────────────────────────────────────────────────────────
E2E_SANDBOX=
E2E_SANDBOX_URL=

# ── Nango (integration layer) ─────────────────────────────────────────────────
# Nango Cloud: secret key from app.nango.dev → Environment settings (UUID v4).
# Self-hosted: secret from local dashboard → API Keys.
NANGO_SECRET_KEY=
# Leave empty for Nango Cloud (SDK defaults to https://api.nango.dev).
# Self-hosted only: set to your instance URL, e.g. http://localhost:3003
NANGO_HOST=
# Apollo (and other provider) credentials are configured in the Nango dashboard,
# not here. Integration key must be "apollo-oauth".

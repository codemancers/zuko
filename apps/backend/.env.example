# ── Core ──────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/zuko_dev
BACKEND_URL=http://localhost:3001
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:3001

# Google (required for calendar/people agents)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3333/oauth/callback

# Enable email/password login for local testing
BETTER_AUTH_INCLUDE_EMAILS_AUTH=false

# ── AI & Agents ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key

# Models (Prefix with provider: openai/, anthropic/)
AGENT_MODEL=openai/gpt-4o
AGENTS_LLM_MODEL=gpt-4o
OPENAI_MODEL=gpt-4o

# LangSmith Tracing
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Zuko

# ── Sprites (Fly sandbox) ─────────────────────────────────────────────────────
SPRITES_ENABLED=false
SPRITES_TOKEN=
SPRITES_API_BASE_URL=https://sprites.fly.dev
AGENT_BRANCH=main
WORKING_DIR=/home/sprite/zuko

# ── E2E / Testing ─────────────────────────────────────────────────────────────
E2E_SANDBOX=
E2E_SANDBOX_URL=

# ── Apollo Integration ─────────────────────────────────────────────────────────────
APOLLO_CLIENT_ID=
APOLLO_CLIENT_SECRET=
APOLLO_REDIRECT_URI=http://localhost:3000/api/integrations/apollo/callback
APOLLO_AUTHORIZATION_ENDPOINT=https://mcp.apollo.io/mcp/oauth_metadata/redirect_to_authorize
APOLLO_TOKEN_ENDPOINT=https://mcp.apollo.io/api/v1/oauth/token
APOLLO_REVOCATION_ENDPOINT=https://mcp.apollo.io/api/v1/oauth/revoke

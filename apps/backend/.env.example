# OpenAI API Key (required)
OPENAI_API_KEY=your-openai-api-key

# LLM Model (optional, defaults to gpt-4o)
AGENTS_LLM_MODEL=gpt-4o

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Zuko

# Google OAuth 2.0 Credentials (required for secretary agent)
# Get these from https://console.cloud.google.com/
# 1. Create a project
# 2. Enable Google Calendar API and People API
# 3. Create OAuth 2.0 credentials (Desktop app type)
# 4. Download and add client ID and secret here
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3333/oauth/callback

# Database URL (required for checkpointing)
DATABASE_URL=postgresql://user:password@localhost:5432/agents

# GitHub OAuth App Credentials (required for user authentication)
# Get these from https://github.com/settings/developers
# 1. Click "New OAuth App"
# 2. Set Application name: Zuko
# 3. Set Homepage URL: http://localhost:4200 (or your frontend URL)
# 4. Set Authorization callback URL: http://localhost:3001/api/auth/callback/github
# 5. Click "Register application" and generate a client secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

GITHUB_APP_SLUG=zuko

# Auth configuration
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:3001
BACKEND_URL=http://localhost:3001

# Email/Password Authentication (optional, for testing purposes)
# Set to "true" to enable email/password authentication
# By default, only GitHub OAuth is enabled
BETTER_AUTH_INCLUDE_EMAILS_AUTH=false

AGENT_TOKEN=

SPRITES_TOKEN=
SPRITES_API_BASE_URL=

# For running E2E locally
E2E_SANDBOX=
E2E_SANDBOX_URL=

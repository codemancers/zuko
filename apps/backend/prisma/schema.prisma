// Datetimes: every DateTime column is `timestamp(3) without time zone` and holds UTC. Defaults that
// read the clock say so (`timezone('utc', now())`) rather than relying on the session's timezone;
// never use `@db.Timestamptz`. A database spec (utc-timestamps.spec.ts) enforces this.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  harnessGrants      HarnessGrant[]
  storedFiles        StoredFile[]
  id                 BigInt              @id @default(autoincrement())
  name               String
  email              String              @unique
  emailVerified      Boolean             @default(false) @map("email_verified")
  image              String?
  createdAt          DateTime            @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  sessions           Session[]
  accounts           Account[]
  members            Member[]
  invitations        Invitation[]
  ownedRecords       ObjectRecord[]
  teamMembers        TeamMember[]
  reportingLines     MemberReporting[]   @relation("ReportingUser")
  managedLines       MemberReporting[]   @relation("ReportingManager")
  ancestorOf         MemberHierarchy[]   @relation("HierarchyAncestor")
  descendantOf       MemberHierarchy[]   @relation("HierarchyDescendant")
  recordShares       RecordShare[]
  oauthclients       OauthClient[]
  recordComments     RecordComment[]
  oauthrefreshtokens OauthRefreshToken[]
  oauthaccesstokens  OauthAccessToken[]
  oauthconsents      OauthConsent[]
  recordEnrichments  RecordEnrichment[]

  @@map("user")
}

model Session {
  id                   BigInt              @id @default(autoincrement())
  expiresAt            DateTime            @map("expires_at")
  token                String              @unique
  createdAt            DateTime            @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  ipAddress            String?             @map("ip_address")
  userAgent            String?             @map("user_agent")
  userId               BigInt              @map("user_id")
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId BigInt?             @map("active_organization_id")
  activeTeamId         BigInt?             @map("active_team_id")
  oauthrefreshtokens   OauthRefreshToken[]
  oauthaccesstokens    OauthAccessToken[]

  @@index([userId])
  @@map("session")
}

model Account {
  id                    BigInt    @id @default(autoincrement())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                BigInt    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("account")
}

model Verification {
  id         BigInt   @id @default(autoincrement())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

model Organization {
  harnessGrants  HarnessGrant[]
  storedFiles    StoredFile[]
  id             BigInt             @id @default(autoincrement())
  name           String
  slug           String             @unique
  logo           String?
  createdAt      DateTime           @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at")
  metadata       String?
  members        Member[]
  invitations    Invitation[]
  objectTypes    ObjectType[]
  teams          Team[]
  reportingLines MemberReporting[]
  hierarchy      MemberHierarchy[]
  roleAccess     RoleObjectAccess[]
  setup          OrganizationSetup?
  setupRunId     String?            @map("setup_run_id")

  @@map("organization")
}

model Member {
  id             BigInt       @id @default(autoincrement())
  organizationId BigInt       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         BigInt       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime     @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at")

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             BigInt       @id @default(autoincrement())
  organizationId BigInt       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime     @map("expires_at")
  createdAt      DateTime     @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at")
  inviterId      BigInt       @map("inviter_id")
  inviter        User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  // better-auth stores one or more team ids here as a comma-separated string.
  teamId         String?      @map("team_id")

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// ---------------------------------------------------------------------------
// CRM data model. Every table carries "organizationId" and is protected by
// row-level security (see the core_data_model migration). Cross-table foreign
// keys are composite on (organizationId, id) so a reference can never cross
// tenants.
// ---------------------------------------------------------------------------

// A kind of record an organization stores: contact, deal, or a custom object.
model ObjectType {
  id             BigInt       @id @default(autoincrement())
  organizationId BigInt       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slug           String
  label          String
  pluralLabel    String       @map("plural_label")
  kind           String // STANDARD | CUSTOM
  version        Int          @default(1)
  createdAt      DateTime     @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  fields       FieldDefinition[]
  records      ObjectRecord[]
  sourceAssocs AssociationDefinition[] @relation("AssociationSource")
  targetAssocs AssociationDefinition[] @relation("AssociationTarget")
  roleAccess   RoleObjectAccess[]

  @@unique([organizationId, slug])
  @@unique([organizationId, id])
  @@map("object_type")
}

// A field on an object type. Values live in ObjectRecord.properties under `name`.
model FieldDefinition {
  id             BigInt     @id @default(autoincrement())
  organizationId BigInt     @map("organization_id")
  objectTypeId   BigInt     @map("object_type_id")
  objectType     ObjectType @relation(fields: [organizationId, objectTypeId], references: [organizationId, id], onDelete: Cascade)
  name           String // snake_case key inside properties
  label          String
  type           String // TEXT, EMAIL, NUMBER, TIMESTAMP, ...
  required       Boolean    @default(false)
  isUnique       Boolean    @default(false) @map("is_unique")
  filterable     Boolean    @default(false)
  readOnly       Boolean    @default(false) @map("read_only")
  sensitive      Boolean    @default(false) // redact in audit history
  maxLength      Int?       @map("max_length")
  config         Json       @default("{}")
  createdAt      DateTime   @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  // Set when the field is removed. The values stay in the records' properties.
  deletedAt      DateTime?  @map("deleted_at")

  @@unique([objectTypeId, name])
  @@index([organizationId, objectTypeId])
  @@map("field_definition")
}

// One row per contact/deal/etc. Field values are stored in `properties`.
model ObjectRecord {
  id             BigInt     @id @default(autoincrement())
  organizationId BigInt     @map("organization_id")
  objectTypeId   BigInt     @map("object_type_id")
  objectType     ObjectType @relation(fields: [organizationId, objectTypeId], references: [organizationId, id], onDelete: Restrict)
  properties     Json       @default("{}")
  ownerId        BigInt?    @map("owner_id")
  owner          User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  // Team the record belongs to. Same-organization is enforced by a trigger.
  teamId         BigInt?    @map("team_id")
  team           Team?      @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdBy      BigInt?    @map("created_by")
  updatedBy      BigInt?    @map("updated_by")
  createdAt      DateTime   @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deletedAt      DateTime?  @map("deleted_at")

  asSource    Association[]      @relation("AssociationSource")
  asTarget    Association[]      @relation("AssociationTarget")
  shares      RecordShare[]
  files       RecordFile[]
  enrichments RecordEnrichment[]
  comments    RecordComment[]

  @@unique([organizationId, id])
  @@index([organizationId, objectTypeId, createdAt(sort: Desc)])
  @@index([organizationId, objectTypeId, ownerId])
  @@index([organizationId, teamId])
  @@index([properties(ops: JsonbPathOps)], type: Gin)
  @@map("object_record")
}

// A kind of link between two object types (e.g. contact <-> company). Always many-to-many.
model AssociationDefinition {
  id                 BigInt     @id @default(autoincrement())
  organizationId     BigInt     @map("organization_id")
  name               String
  label              String
  sourceObjectTypeId BigInt     @map("source_object_type_id")
  sourceObjectType   ObjectType @relation("AssociationSource", fields: [organizationId, sourceObjectTypeId], references: [organizationId, id], onDelete: Cascade)
  targetObjectTypeId BigInt     @map("target_object_type_id")
  targetObjectType   ObjectType @relation("AssociationTarget", fields: [organizationId, targetObjectTypeId], references: [organizationId, id], onDelete: Cascade)
  // Whether a source record may be linked to many target records, or only one. The target side is always many.
  many               Boolean    @default(true)
  // What the target object calls these links, e.g. "Deals (Primary contact)"; defaults from the source's field.
  reverseLabel       String?    @map("reverse_label")
  isDefault          Boolean    @default(false) @map("is_default")
  isLookup           Boolean    @default(false) @map("is_lookup")
  isActive           Boolean    @default(true) @map("is_active")

  associations Association[]

  @@unique([organizationId, name])
  @@unique([organizationId, id])
  @@map("association_definition")
}

// A link between two records, of a given definition.
model Association {
  id             BigInt                @id @default(autoincrement())
  organizationId BigInt                @map("organization_id")
  definitionId   BigInt                @map("definition_id")
  definition     AssociationDefinition @relation(fields: [organizationId, definitionId], references: [organizationId, id], onDelete: Cascade)
  sourceId       BigInt                @map("source_id")
  source         ObjectRecord          @relation("AssociationSource", fields: [organizationId, sourceId], references: [organizationId, id], onDelete: Cascade)
  targetId       BigInt                @map("target_id")
  target         ObjectRecord          @relation("AssociationTarget", fields: [organizationId, targetId], references: [organizationId, id], onDelete: Cascade)
  createdAt      DateTime              @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at")

  @@unique([organizationId, definitionId, sourceId, targetId])
  @@index([organizationId, definitionId, targetId, sourceId])
  @@map("association")
}

// ---------------------------------------------------------------------------
// Teams (better-auth organization plugin, `teams.enabled`). Managed by
// better-auth through the plain client, so these tables are not under RLS.
// ---------------------------------------------------------------------------

model Team {
  id             BigInt       @id @default(autoincrement())
  name           String
  memberCount    Int          @default(0) @map("member_count")
  organizationId BigInt       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at")
  updatedAt      DateTime?    @updatedAt @map("updated_at")

  members TeamMember[]
  records ObjectRecord[]
  shares  RecordShare[]

  @@index([organizationId])
  @@map("team")
}

model TeamMember {
  id            BigInt    @id @default(autoincrement())
  teamId        BigInt    @map("team_id")
  team          Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId        BigInt    @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  membershipKey String?   @unique @map("membership_key")
  createdAt     DateTime? @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at")

  @@index([teamId])
  @@index([userId])
  @@map("team_member")
}

// ---------------------------------------------------------------------------
// Audit. Append-only (enforced by triggers and revoked privileges, see the audit
// migration). Deliberately no foreign keys: history must outlive the rows it
// describes, including a hard-deleted record or organization.
// ---------------------------------------------------------------------------

// What changed on a record, written by the service layer in the same transaction
// as the change itself.
model RecordChange {
  id             BigInt   @id @default(autoincrement())
  organizationId BigInt   @map("organization_id")
  recordId       BigInt   @map("record_id")
  objectTypeId   BigInt   @map("object_type_id")
  action         String // CREATE | UPDATE | DELETE
  changes        Json // {"stage": {"old": "open", "new": "closed_won"}}
  actorType      String   @map("actor_type") // USER | API_KEY | SYSTEM | IMPORT | MCP | AGENT
  actorId        BigInt?  @map("actor_id")
  requestId      String?  @map("request_id")
  createdAt      DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at")

  @@index([organizationId, recordId, createdAt])
  @@index([organizationId, objectTypeId, createdAt])
  @@map("record_change")
}

// Auth and organization events (sign-in, invitations, role and team changes...),
// written by the better-auth audit plugin. organizationId is null for events that
// A comment on a record. Shown beside RecordChange rows in one timeline (the activity feed),
// but kept apart: a change is immutable history, a comment can be edited and removed by its author.
model RecordComment {
  id             BigInt        @id @default(autoincrement())
  organizationId BigInt        @map("organization_id")
  recordId       BigInt        @map("record_id")
  record         ObjectRecord  @relation(fields: [organizationId, recordId], references: [organizationId, id], onDelete: Cascade)
  objectTypeId   BigInt        @map("object_type_id")
  authorId       BigInt?       @map("author_id")
  author         User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  actorType      String        @map("actor_type") // USER | MCP | AGENT
  // Markdown.
  body           String
  // Members mentioned with @; each can read the record (checked when written).
  mentions       BigInt[]      @default([])
  editedAt       DateTime?     @map("edited_at")
  createdAt      DateTime      @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at")
  deletedAt      DateTime?     @map("deleted_at")
  files          CommentFile[]

  @@unique([organizationId, id])
  @@index([organizationId, recordId, createdAt, id])
  @@map("record_comment")
}

// belong to no organization, such as a failed sign-in.
model AuditEvent {
  id             BigInt   @id @default(autoincrement())
  organizationId BigInt?  @map("organization_id")
  actorType      String   @map("actor_type") // USER | API_KEY | SYSTEM | IMPORT | MCP | AGENT | ANONYMOUS
  actorId        BigInt?  @map("actor_id")
  event          String // 'member.invited', 'api_key.created', ...
  targetType     String?  @map("target_type")
  targetId       BigInt?  @map("target_id")
  metadata       Json?
  ip             String?
  userAgent      String?  @map("user_agent")
  requestId      String?  @map("request_id")
  createdAt      DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at")

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, event, createdAt(sort: Desc)])
  @@map("audit_event")
}

// ---------------------------------------------------------------------------
// Reporting lines (better-auth hierarchy plugin, libs/better-auth-hierarchy).
// Managed by better-auth through the plain client, so like member and team these
// tables are not under RLS; readers must filter by organizationId.
// ---------------------------------------------------------------------------

// Who reports to whom. managerId is null for someone at the top of the chart.
model MemberReporting {
  id             BigInt       @id @default(autoincrement())
  organizationId BigInt       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         BigInt       @map("user_id")
  user           User         @relation("ReportingUser", fields: [userId], references: [id], onDelete: Cascade)
  managerId      BigInt?      @map("manager_id")
  manager        User?        @relation("ReportingManager", fields: [managerId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([managerId])
  @@map("member_reporting")
}

// Every (ancestor, descendant) pair at any depth, rebuilt from MemberReporting.
model MemberHierarchy {
  id             BigInt       @id @default(autoincrement())
  organizationId BigInt       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ancestorId     BigInt       @map("ancestor_id")
  ancestor       User         @relation("HierarchyAncestor", fields: [ancestorId], references: [id], onDelete: Cascade)
  descendantId   BigInt       @map("descendant_id")
  descendant     User         @relation("HierarchyDescendant", fields: [descendantId], references: [id], onDelete: Cascade)
  depth          Int // 1 = direct report

  @@unique([organizationId, ancestorId, descendantId])
  @@index([organizationId, descendantId])
  @@map("member_hierarchy")
}

// ---------------------------------------------------------------------------
// Record access. Roles say what a user may do (see libs/access-control); these say
// which records an action may touch. Both tables are under RLS.
// ---------------------------------------------------------------------------

// Overrides of the default scope for a role, for one object type or (when
// objectTypeId is null) for all of them. Without a row, the service's built-in
// defaults apply.
model RoleObjectAccess {
  id             BigInt       @id @default(autoincrement())
  organizationId BigInt       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String // organization role name, e.g. member
  objectTypeId   BigInt?      @map("object_type_id") // null = every object type
  objectType     ObjectType?  @relation(fields: [objectTypeId], references: [id], onDelete: Cascade)
  readScope      String       @map("read_scope") // OWN | OWN_AND_REPORTS | TEAM | ALL
  writeScope     String       @map("write_scope") // OWN | OWN_AND_REPORTS | TEAM | ALL
  createdAt      DateTime     @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([organizationId, role, objectTypeId])
  @@map("role_object_access")
}

// Explicit access to one record for a user or a team, on top of the role scope.
model RecordShare {
  id             BigInt       @id @default(autoincrement())
  organizationId BigInt       @map("organization_id")
  recordId       BigInt       @map("record_id")
  record         ObjectRecord @relation(fields: [organizationId, recordId], references: [organizationId, id], onDelete: Cascade)
  userId         BigInt?      @map("user_id") // exactly one of userId / teamId
  user           User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId         BigInt?      @map("team_id")
  team           Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  access         String // READ | WRITE
  createdBy      BigInt?      @map("created_by")
  createdAt      DateTime     @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at")

  @@index([organizationId, recordId])
  @@index([organizationId, userId])
  @@index([organizationId, teamId])
  @@map("record_share")
}

// ---------------------------------------------------------------------------
// MCP authorization server (better-auth jwt + mcp plugins, apps/backend
// libs/better-auth/oauth-plugins.ts): signing keys, registered OAuth clients,
// consents and tokens. Generated by `auth generate`, then adapted to bigint ids.
// ---------------------------------------------------------------------------

model Jwks {
  id         BigInt    @id @default(autoincrement())
  publicKey  String    @map("public_key")
  privateKey String    @map("private_key")
  createdAt  DateTime  @map("created_at")
  expiresAt  DateTime? @map("expires_at")
  alg        String?
  crv        String?

  @@map("jwks")
}

model OauthClient {
  id                               BigInt                @id @default(autoincrement())
  clientId                         String                @map("client_id")
  clientSecret                     String?               @map("client_secret")
  clientDiscoveryId                String?               @map("client_discovery_id")
  disabled                         Boolean?              @default(false)
  skipConsent                      Boolean?              @map("skip_consent")
  enableEndSession                 Boolean?              @map("enable_end_session")
  subjectType                      String?               @map("subject_type")
  scopes                           String[]
  clientCredentialsScopes          String[]              @default([]) @map("client_credentials_scopes")
  userId                           BigInt?               @map("user_id")
  user                             User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                        DateTime?             @map("created_at")
  updatedAt                        DateTime?             @map("updated_at")
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]
  tos                              String?
  policy                           String?
  softwareId                       String?               @map("software_id")
  softwareVersion                  String?               @map("software_version")
  softwareStatement                String?               @map("software_statement")
  redirectUris                     String[]              @map("redirect_uris")
  postLogoutRedirectUris           String[]              @map("post_logout_redirect_uris")
  backchannelLogoutUri             String?               @map("backchannel_logout_uri")
  backchannelLogoutSessionRequired Boolean?              @map("backchannel_logout_session_required")
  tokenEndpointAuthMethod          String?               @map("token_endpoint_auth_method")
  applicationType                  String?               @map("application_type")
  jwks                             String?
  jwksUri                          String?               @map("jwks_uri")
  grantTypes                       String[]              @map("grant_types")
  responseTypes                    String[]              @map("response_types")
  requirePKCE                      Boolean?              @map("require_pkce")
  dpopBoundAccessTokens            Boolean?              @default(false) @map("dpop_bound_access_tokens")
  referenceId                      String?               @map("reference_id")
  metadata                         Json?
  oauthclientresources             OauthClientResource[]
  oauthrefreshtokens               OauthRefreshToken[]
  oauthaccesstokens                OauthAccessToken[]
  oauthconsents                    OauthConsent[]

  @@unique([clientId])
  @@index([userId])
  @@map("oauth_client")
}

model OauthClientAssertion {
  id        BigInt   @id @default(autoincrement())
  expiresAt DateTime @map("expires_at")

  @@map("oauth_client_assertion")
}

model OauthResource {
  id                            BigInt                @id @default(autoincrement())
  identifier                    String
  name                          String
  accessTokenTtl                Int?                  @map("access_token_ttl")
  refreshTokenTtl               Int?                  @map("refresh_token_ttl")
  signingAlgorithm              String?               @map("signing_algorithm")
  signingKeyId                  String?               @map("signing_key_id")
  allowedScopes                 String[]              @map("allowed_scopes")
  customClaims                  Json?                 @map("custom_claims")
  dpopBoundAccessTokensRequired Boolean?              @default(false) @map("dpop_bound_access_tokens_required")
  disabled                      Boolean?              @default(false)
  createdAt                     DateTime?             @map("created_at")
  updatedAt                     DateTime?             @map("updated_at")
  policyVersion                 Int?                  @default(1) @map("policy_version")
  metadata                      Json?
  oauthclientresources          OauthClientResource[]

  @@unique([identifier])
  @@map("oauth_resource")
}

model OauthClientResource {
  id            BigInt        @id @default(autoincrement())
  clientId      String        @map("client_id")
  oauthclient   OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId    String        @map("resource_id")
  oauthresource OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)
  metadata      Json?
  createdAt     DateTime?     @map("created_at")

  @@unique([clientId, resourceId], map: "oauth_client_resource_client_id_resource_id_uidx")
  @@index([clientId])
  @@index([resourceId])
  @@map("oauth_client_resource")
}

model OauthRefreshToken {
  id                      BigInt             @id @default(autoincrement())
  token                   String
  clientId                String             @map("client_id")
  oauthclient             OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               BigInt?            @map("session_id")
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  BigInt             @map("user_id")
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?            @map("reference_id")
  authorizationCodeId     String?            @map("authorization_code_id")
  resources               String[]
  requestedUserInfoClaims String[]           @map("requested_user_info_claims")
  expiresAt               DateTime           @map("expires_at")
  createdAt               DateTime           @map("created_at")
  revoked                 DateTime?
  rotatedAt               DateTime?          @map("rotated_at")
  rotationReplayResponse  String?            @map("rotation_replay_response")
  rotationReplayExpiresAt DateTime?          @map("rotation_replay_expires_at")
  authTime                DateTime?          @map("auth_time")
  confirmation            Json?
  scopes                  String[]
  oauthaccesstokens       OauthAccessToken[]

  @@unique([token])
  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("oauth_refresh_token")
}

model OauthAccessToken {
  id                      BigInt             @id @default(autoincrement())
  token                   String
  clientId                String             @map("client_id")
  oauthclient             OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               BigInt?            @map("session_id")
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  BigInt?            @map("user_id")
  user                    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?            @map("reference_id")
  authorizationCodeId     String?            @map("authorization_code_id")
  resources               String[]
  requestedUserInfoClaims String[]           @map("requested_user_info_claims")
  refreshId               BigInt?            @map("refresh_id")
  oauthrefreshtoken       OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)
  expiresAt               DateTime           @map("expires_at")
  createdAt               DateTime           @map("created_at")
  revoked                 DateTime?
  confirmation            Json?
  scopes                  String[]

  @@unique([token])
  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("oauth_access_token")
}

model OauthConsent {
  id                      BigInt      @id @default(autoincrement())
  clientId                String      @map("client_id")
  oauthclient             OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                  BigInt?     @map("user_id")
  user                    User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?     @map("reference_id")
  resources               String[]
  requestedUserInfoClaims String[]    @map("requested_user_info_claims")
  scopes                  String[]
  createdAt               DateTime    @map("created_at")
  updatedAt               DateTime    @map("updated_at")

  @@index([clientId])
  @@index([userId])
  @@map("oauth_consent")
}

// Setup state doubles as a durable request to attach a Workflow SDK run.
model OrganizationSetup {
  id             BigInt       @id @default(autoincrement())
  organizationId BigInt       @unique @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status         String       @default("pending") // pending | running | ready | failed
  attempt        Int          @default(1)
  runId          String?      @map("run_id")
  error          String?
  createdAt      DateTime     @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@map("organization_setup")
}

// A reference is usable only by the authenticated harness, never as a bearer token.
model HarnessGrant {
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  id             BigInt       @id @default(autoincrement())
  organizationId BigInt       @map("organization_id")
  userId         BigInt       @map("user_id")
  reference      String       @unique
  sourceType     String       @map("source_type")
  sourceId       BigInt       @map("source_id")
  scopes         String[]
  scopesKey      String       @map("scopes_key")
  expiresAt      DateTime     @map("expires_at")
  createdAt      DateTime     @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at")

  @@unique([organizationId, sourceType, sourceId, scopesKey])
  @@map("harness_grant")
}

// Metadata for an uploaded file; the bytes live in the storage driver under `storageKey`.
// A file is attached to a record through a FILE field (see RecordFile).
model StoredFile {
  id             BigInt        @id @default(autoincrement())
  organizationId BigInt        @map("organization_id")
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  uploadedBy     BigInt?       @map("uploaded_by")
  uploader       User?         @relation(fields: [uploadedBy], references: [id], onDelete: SetNull, onUpdate: NoAction)
  filename       String
  mediaType      String        @map("media_type")
  size           Int
  sha256         String
  storageKey     String        @unique @map("storage_key")
  createdAt      DateTime      @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at")
  // Soft delete; a cleanup job removes the bytes later.
  deletedAt      DateTime?     @map("deleted_at")
  attachments    RecordFile[]
  commentFiles   CommentFile[]

  @@unique([organizationId, id])
  @@index([organizationId, uploadedBy])
  @@map("stored_file")
}

// A file attached to a record through one of its FILE fields. A file may be attached to many records.
model RecordFile {
  id             BigInt       @id @default(autoincrement())
  organizationId BigInt       @map("organization_id")
  recordId       BigInt       @map("record_id")
  record         ObjectRecord @relation(fields: [organizationId, recordId], references: [organizationId, id], onDelete: Cascade)
  fieldName      String       @map("field_name")
  fileId         BigInt       @map("file_id")
  file           StoredFile   @relation(fields: [organizationId, fileId], references: [organizationId, id], onDelete: Cascade)
  position       Int          @default(0)
  createdBy      BigInt?      @map("created_by")
  createdAt      DateTime     @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at")

  @@unique([recordId, fieldName, fileId])
  @@index([organizationId, fileId])
  @@index([organizationId, recordId, fieldName, position])
  @@map("record_file")
}

// A file attached to a comment. A file may be attached to many comments and records.
model CommentFile {
  id             BigInt        @id @default(autoincrement())
  organizationId BigInt        @map("organization_id")
  commentId      BigInt        @map("comment_id")
  comment        RecordComment @relation(fields: [organizationId, commentId], references: [organizationId, id], onDelete: Cascade)
  fileId         BigInt        @map("file_id")
  file           StoredFile    @relation(fields: [organizationId, fileId], references: [organizationId, id], onDelete: Cascade)
  position       Int           @default(0)
  createdAt      DateTime      @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at")

  @@unique([commentId, fileId])
  @@index([organizationId, fileId])
  @@map("comment_file")
}

// A single-use, short-lived link to upload one file, bound to the user who asked for it. Only a
// hash of the secret is stored.
model UploadTicket {
  id             BigInt    @id @default(autoincrement())
  organizationId BigInt    @map("organization_id")
  userId         BigInt    @map("user_id")
  secretHash     String    @map("secret_hash")
  actorType      String    @map("actor_type")
  expiresAt      DateTime  @map("expires_at")
  usedAt         DateTime? @map("used_at")
  createdAt      DateTime  @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at")

  @@index([organizationId, expiresAt])
  @@map("upload_ticket")
}

// The raw response a data provider (Apollo) returned for a record. Kept apart from `properties`: it is
// large, its shape is the provider's, and it must not feed the property index or the change history.
model RecordEnrichment {
  id             BigInt       @id @default(autoincrement())
  organizationId BigInt       @map("organization_id")
  recordId       BigInt       @map("record_id")
  record         ObjectRecord @relation(fields: [organizationId, recordId], references: [organizationId, id], onDelete: Cascade)
  provider       String
  subject        String // PERSON | ORGANIZATION
  externalId     String?      @map("external_id")
  payload        Json
  requestedBy    BigInt?      @map("requested_by")
  requester      User?        @relation(fields: [requestedBy], references: [id], onDelete: SetNull)
  fetchedAt      DateTime     @default(dbgenerated("timezone('utc'::text, now())")) @map("fetched_at")

  @@unique([recordId, provider, subject])
  @@unique([organizationId, id])
  @@map("record_enrichment")
}

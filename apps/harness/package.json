{
  "name": "@zuko/harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "eve dev",
    "build": "eve build",
    "start": "eve start --port 3002"
  },
  "nx": {
    "projectType": "application",
    "tags": [
      "type:app",
      "scope:backend"
    ],
    "targets": {
      "dev": {
        "executor": "nx:run-commands",
        "continuous": true,
        "options": {
          "command": "eve dev",
          "cwd": "apps/harness"
        }
      },
      "build": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/.output",
          "{projectRoot}/.eve"
        ],
        "options": {
          "command": "eve build",
          "cwd": "apps/harness"
        }
      },
      "start": {
        "executor": "nx:run-commands",
        "continuous": true,
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "eve start --port 3002",
          "cwd": "apps/harness"
        }
      },
      "test": {
        "executor": "@nx/vitest:test",
        "outputs": [
          "{workspaceRoot}/apps/harness/test-output/vitest/coverage"
        ],
        "options": {
          "configFile": "apps/harness/vitest.config.mts"
        },
        "configurations": {
          "watch": {
            "watch": true
          }
        },
        "parallelism": false
      }
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.114",
    "@fly/sprites": "0.0.1-rc37",
    "ai": "^7.0.0",
    "ai-sdk-provider-claude-code": "^3.5.0",
    "eve": "0.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.19.9",
    "typescript": "~5.9.2"
  }
}

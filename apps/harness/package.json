{
  "name": "harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./agent/*"
  },
  "scripts": {
    "build": "eve build",
    "dev": "eve dev",
    "start": "eve start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ai": "^7.0.181",
    "eve": "1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~6.0.3"
  },
  "nx": {
    "targets": {
      "build": {
        "inputs": [
          "default",
          "^default",
          {
            "env": "BACKEND_URL"
          },
          {
            "env": "FRONTEND_URL"
          }
        ],
        "outputs": [
          "{projectRoot}/.output"
        ]
      }
    }
  }
}

{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/vitest",
    "jsx": "preserve",
    "types": ["vitest/globals", "node", "@testing-library/jest-dom"],
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "include": [
    "vitest.config.ts",
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx",
    "src/**/*.d.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.json"
    }
  ]
}

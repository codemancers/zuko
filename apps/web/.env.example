# Frontend configuration

# Public app URL (used for OAuth callbacks and public-facing URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend URL for the web app (defaults to http://localhost:3001 in development)
# Set this in production to point to your deployed backend
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Email/Password Authentication (optional, for testing purposes)
# Set to "true" to enable email/password authentication
# By default, only Google OAuth is enabled
NEXT_PUBLIC_BETTER_AUTH_INCLUDE_EMAILS_AUTH=false

{
  "name": "@zuko/web",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "@ai-sdk/react": "^3.0.72",
    "@bprogress/react": "1.2.7",
    "@editorjs/code": "^2.9.4",
    "@editorjs/editorjs": "^2.31.5",
    "@editorjs/header": "^2.8.8",
    "@editorjs/inline-code": "^1.5.2",
    "@editorjs/list": "^2.0.9",
    "@editorjs/marker": "^1.4.0",
    "@editorjs/quote": "^2.7.6",
    "@zuko/ui-kit": "0.0.1",
    "ai": "^6.0.70",
    "better-auth": "^1.5.4",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "next": "~16.0.1",
    "nuqs": "^2.8.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7"
  },
  "nx": {
    "targets": {
      "dev": {
        "dependsOn": [
          "@zuko/backend:serve"
        ],
        "continuous": true
      },
      "docker:build": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "export FLY_APP=$(grep '^app = ' apps/web/fly.toml | cut -d \"'\" -f 2) && export GIT_SHA=$(git rev-parse --short HEAD) && docker build --platform linux/amd64 -f apps/web/Dockerfile -t registry.fly.io/$FLY_APP:$GIT_SHA ."
        }
      },
      "deploy": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "docker:build"
        ],
        "options": {
          "command": "export FLY_APP=$(grep '^app = ' apps/web/fly.toml | cut -d \"'\" -f 2) && export GIT_SHA=$(git rev-parse --short HEAD) && flyctl auth docker && docker push registry.fly.io/$FLY_APP:$GIT_SHA && fly deploy --image registry.fly.io/$FLY_APP:$GIT_SHA -c apps/web/fly.toml"
        }
      },
      "build": {
        "outputs": [
          "{projectRoot}/.next",
          "!{projectRoot}/.next/cache",
          "!{projectRoot}/.next/standalone"
        ]
      },
      "test": {
        "executor": "@nx/vitest:test",
        "outputs": [
          "{workspaceRoot}/apps/web/test-output/vitest/coverage"
        ],
        "options": {
          "configFile": "apps/web/vitest.config.ts"
        },
        "configurations": {
          "watch": {
            "watch": true
          }
        }
      }
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "shiki": "3.23.0"
  }
}

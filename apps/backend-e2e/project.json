{
  "name": "@zuko/backend-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/backend-e2e/src",
  "projectType": "application",
  "targets": {
    "e2e": {
      "executor": "@nx/vitest:test",
      "outputs": ["{projectRoot}/test-output/vitest/coverage"],
      "options": {
        "configFile": "apps/backend-e2e/vitest.config.ts",
        "passWithNoTests": true
      },
      "dependsOn": ["@zuko/backend:build"]
    }
  },
  "implicitDependencies": ["@zuko/backend"]
}

OPENAI_API_KEY=

# Zuko backend URL — must match backend's BACKEND_URL
ZUKO_BACKEND_URL=http://localhost:3001

# Required for local TUI dev (localDev() bypasses session auth).
# Not needed when using real Better Auth session (HTTP API with cookie).
ZUKO_ORG_ID=

# Session cookie for TUI dev — copy `better-auth.session_token` value from
# browser DevTools → Application → Cookies after logging into Zuko web.
ZUKO_SESSION_TOKEN=

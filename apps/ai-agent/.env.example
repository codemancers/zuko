# Model access — direct OpenAI provider (gpt-4.1).
OPENAI_API_KEY=

# Route auth secret for the eve HTTP channel (production).
# Callers must present a Bearer JWT signed with HS256 using this secret,
# issuer "zuko", audience "zuko-ai-agent". Loopback requests skip this check.
# Generate: openssl rand -base64 32
EVE_AUTH_SECRET=

# Zuko backend. IMPORTANT: must exactly match the backend's BACKEND_URL —
# it is used as the JWT audience during agent-auth verification.
ZUKO_BACKEND_URL=http://localhost:3001

# Organization the agent operates in (x-org-id header on every API call).
ZUKO_ORG_ID=1

# Default owner (CRM user id) for created contacts/companies/deals.
ZUKO_DEFAULT_OWNER_ID=1

# Agent identity.
ZUKO_AGENT_NAME=zuko-eve-agent

# Host identity vouching for this agent. Provision once with
# `bun run provision:agent-host` in apps/backend and paste its output here.
ZUKO_HOST_ID=
ZUKO_HOST_PRIVATE_JWK=
ZUKO_HOST_PUBLIC_JWK=

# Where self-registered agent credentials are persisted. In Docker, mount a
# volume here (the image defaults this to /data).
ZUKO_AGENT_STATE_DIR=./.zuko

# Optional pre-registered agent credentials (production path — run
# `bun run register` once and store the output in your secret manager; skips
# self-registration, so ZUKO_HOST_* is not needed at runtime).
# ZUKO_AGENT_ID=
# ZUKO_AGENT_PRIVATE_JWK=
# ZUKO_AGENT_PUBLIC_JWK=

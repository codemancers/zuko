# OpenAI model access
OPENAI_API_KEY=

# Zuko backend URL — must match backend's BACKEND_URL (JWT audience)
ZUKO_BACKEND_URL=http://localhost:3001

# Organization the agent operates in (required for local TUI dev via localDev() bypass)
ZUKO_ORG_ID=

# Host identity for first-time agent self-registration.
# Run `bun run provision:agent-host` in apps/backend once to get these values.
# Not needed after .zuko/agent-credentials.json is created.
ZUKO_HOST_ID=
ZUKO_HOST_PRIVATE_JWK=

# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data

test-output

.env
.env.local
.env.test
.env.production
.env.test.local
/prisma/


# Environment files with secrets

# TypeScript build info
*.tsbuildinfo

# Next.js
.next
out
next-env.d.ts

vite.config.*.timestamp*
vitest.config.*.timestamp*
.env.test.local

# Development screenshots (don't commit to repo)
/*.png
/after-*
/before-*
/current-*
/dialog-*
/menu-*
/logged-*
/chat-*
/contacts-*
/mentions-*
/with-*
/[0-9]*-*

# AI agents and rules files
# Local Claude Code state stays out, but .claude/skills is shared: it holds the
# symlinks that point Claude Code at the canonical skills in .agents/skills.
.claude/*
!.claude/skills/
.cursorrules
.windsurfrules
.gemini
.mcp.json
AGENTS.md
CLAUDE.md
GEMINI.md
.antigravity/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Nango runtime data
nango-data/

# Agent skills are committed. The canonical copies live in .agents/skills, where
# every agent that follows the convention reads them, and skills-lock.json
# records each skill's source repo and content hash so installs are reproducible.
.agents/*
!.agents/skills/

.nx/polygraph
.nx/self-healing
.nx/migrate-runs

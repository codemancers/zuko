// ============================================
// SALES MODELS
// ============================================

model Contact {
  id             Int          @id @default(autoincrement())
  organizationId Int          @map("organization_id")
  name           String
  email          String?
  phone          String? // E.164 format (e.g., +14155552671)
  linkedinId     String?      @map("linkedin_id")
  notes          Json?        @map("notes")
  fields         Json         @default("{}") @map("fields")
  isHidden       Boolean      @default(false) @map("is_hidden")
  // External system identity. externalType names the system (apollo | origami |
  // salesforce | ...), externalId is who they are in it. See
  // docs/concepts/external-identity.mdx.
  externalType String? @map("external_type")
  externalId   String? @map("external_id")
  // Our record inside that system's workspace (e.g. Apollo contact id),
  // as opposed to the identity above. Written on sync, never used to match.
  externalRecordId String? @map("external_record_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation("OrganizationContacts", fields: [organizationId], references: [id], onDelete: Cascade)
  owners         ContactOwner[]
  companyHistory CompanyContact[]
  deals          DealContact[]
  leads          Lead[]       @relation("ContactLeads")
  prospects      Prospect[]   @relation("ContactProspects")

  @@index([organizationId])
  @@index([isHidden])
  @@index([email])
  @@index([phone])
  @@index([linkedinId])
  @@index([externalType, externalId])
  @@index([externalRecordId])
  @@map("contact")
  @@schema("sales")
}

model ContactOwner {
  id         Int      @id @default(autoincrement())
  contactId  Int      @map("contact_id")
  userId     Int      @map("user_id")
  isPrimary  Boolean  @default(false) @map("is_primary")
  assignedAt DateTime @default(now()) @map("assigned_at")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contactId, userId])
  @@index([userId])
  @@index([contactId])
  @@map("contact_owner")
  @@schema("sales")
}

model Activity {
  id           Int      @id @default(autoincrement())
  activityType String   @map("activity_type") // 'comment' | 'field_update' | 'status_change' | 'assignment' | etc.
  entityType   String   @map("entity_type") // 'contact' | 'company' | 'deal'
  entityId     Int      @map("entity_id") // ID of the contact/company/deal
  actorId      Int?     @map("actor_id") // null for system events
  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  content      String?  @db.Text // For comments
  metadata     Json? // Flexible data for different activity types
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([entityType, entityId, createdAt])
  @@index([actorId])
  @@index([activityType])
  @@map("activity")
  @@schema("sales")
}

model Company {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  companyName    String   @map("company_name")
  website        String?
  linkedinUrl    String?  @map("linkedin_url")
  summary        Json?    @map("summary")
  isHidden       Boolean  @default(false) @map("is_hidden")
  fields         Json     @default("{}") @map("fields")
  // External system identity. externalType names the system (apollo | origami |
  // salesforce | ...), externalId is who they are in it. See
  // docs/concepts/external-identity.mdx.
  externalType String? @map("external_type")
  externalId   String? @map("external_id")
  externalRecordId String? @map("external_record_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  organization Organization @relation("OrganizationCompanies", fields: [organizationId], references: [id], onDelete: Cascade)
  contacts    CompanyContact[]
  owners      CompanyOwner[]
  deals       DealCompany[]

  @@index([organizationId])
  @@index([isHidden])
  @@index([companyName])
  @@index([externalType, externalId])
  @@index([externalRecordId])
  @@map("company")
  @@schema("sales")
}

model CompanyContact {
  id        Int       @id @default(autoincrement())
  companyId Int       @map("company_id")
  contactId Int       @map("contact_id")
  joinedAt  DateTime  @default(now()) @map("joined_at")
  leftAt    DateTime? @map("left_at")
  role      String? // e.g., "employee", "contractor", "advisor"
  isPrimary Boolean   @default(false) @map("is_primary") // primary employer
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([contactId])
  @@index([leftAt])
  @@map("company_contact")
  @@schema("sales")
}

model CompanyOwner {
  id         Int      @id @default(autoincrement())
  companyId  Int      @map("company_id")
  userId     Int      @map("user_id")
  isPrimary  Boolean  @default(false) @map("is_primary")
  assignedAt DateTime @default(now()) @map("assigned_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
  @@index([companyId])
  @@map("company_owner")
  @@schema("sales")
}

model Deal {
  id                Int       @id @default(autoincrement())
  organizationId    Int       @map("organization_id")
  title             String
  value             Decimal?  @db.Decimal(15, 2)
  currency          String?   @default("USD")
  probability       Int?      @default(50)
  stage             String    @default("prospecting")
  summary           Json?     @map("summary")
  expectedCloseDate DateTime? @map("expected_close_date")
  actualCloseDate   DateTime? @map("actual_close_date")
  lostReason        String?   @map("lost_reason")
  source            String?
  priority          Int?      @default(2)
  isHidden          Boolean   @default(false) @map("is_hidden")
  fields            Json      @default("{}") @map("fields")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  organization Organization @relation("OrganizationDeals", fields: [organizationId], references: [id], onDelete: Cascade)
  companies    DealCompany[]
  contacts     DealContact[]
  owners       DealOwner[]
  leads        Lead[]       @relation("DealLeads")

  @@index([organizationId])
  @@index([isHidden])
  @@index([stage])
  @@index([expectedCloseDate])
  @@index([actualCloseDate])
  @@index([createdAt])
  @@map("deal")
  @@schema("sales")
}

model DealCompany {
  id        Int      @id @default(autoincrement())
  dealId    Int      @map("deal_id")
  companyId Int      @map("company_id")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  deal    Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([dealId, companyId])
  @@index([dealId])
  @@index([companyId])
  @@map("deal_company")
  @@schema("sales")
}

model DealContact {
  id        Int      @id @default(autoincrement())
  dealId    Int      @map("deal_id")
  contactId Int      @map("contact_id")
  role      String?
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  deal    Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([dealId, contactId])
  @@index([dealId])
  @@index([contactId])
  @@index([role])
  @@map("deal_contact")
  @@schema("sales")
}

model DealOwner {
  id         Int      @id @default(autoincrement())
  dealId     Int      @map("deal_id")
  userId     Int      @map("user_id")
  isPrimary  Boolean  @default(false) @map("is_primary")
  assignedAt DateTime @default(now()) @map("assigned_at")

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dealId, userId])
  @@index([userId])
  @@index([dealId])
  @@map("deal_owner")
  @@schema("sales")
}

model IcpProfile {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  name           String
  description    Json?    @map("description")
  filters        Json     @default("{}") @map("filters")
  notes          Json?    @map("notes")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation("OrganizationIcpProfiles", fields: [organizationId], references: [id], onDelete: Cascade)
  campaigns    Campaign[]   @relation("IcpCampaigns")
  leads        Lead[]       @relation("IcpLeads")
  prospects    Prospect[]   @relation("IcpProspects")

  @@index([organizationId])
  @@map("icp_profile")
  @@schema("sales")
}

model Campaign {
  id                 Int      @id @default(autoincrement())
  organizationId     Int      @map("organization_id")
  createdById        Int      @map("created_by_id")
  icpProfileId       Int?     @map("icp_profile_id")
  name               String
  // External system identity. externalType names the system (apollo | origami |
  // salesforce | ...), externalId is who they are in it. See
  // docs/concepts/external-identity.mdx.
  externalType String  @default("apollo") @map("external_type")
  externalId   String? @map("external_id")
  active             Boolean  @default(false)
  permissions        String   @default("team_can_use")
  sequence           Json     @default("[]")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization Organization @relation("OrganizationCampaigns", fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("CreatedCampaigns", fields: [createdById], references: [id])
  icpProfile   IcpProfile?  @relation("IcpCampaigns", fields: [icpProfileId], references: [id], onDelete: SetNull)
  leads        Lead[]       @relation("CampaignLeads")
  memberships  CampaignMembership[] @relation("CampaignMemberships")

  @@unique([organizationId, externalType, externalId])
  @@index([organizationId])
  @@index([icpProfileId])
  @@map("campaign")
  @@schema("sales")
}

model Lead {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  icpProfileId   Int?     @map("icp_profile_id")
  campaignId     Int?     @map("campaign_id")
  contactId      Int?     @map("contact_id")
  dealId         Int?     @map("deal_id")
  name           String
  email          String?
  phone          String?
  companyName    String?  @map("company_name")
  title          String?
  linkedinUrl    String?  @map("linkedin_url")
  status         String   @default("replied")
  source         String   @default("manual")
  externalType   String?  @map("external_type")
  externalId     String?  @map("external_id")
  notes          Json?
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation("OrganizationLeads", fields: [organizationId], references: [id], onDelete: Cascade)
  icpProfile   IcpProfile?  @relation("IcpLeads", fields: [icpProfileId], references: [id])
  campaign     Campaign?    @relation("CampaignLeads", fields: [campaignId], references: [id], onDelete: SetNull)
  contact      Contact?     @relation("ContactLeads", fields: [contactId], references: [id], onDelete: SetNull)
  deal         Deal?        @relation("DealLeads", fields: [dealId], references: [id], onDelete: SetNull)
  prospect     Prospect?    @relation("ProspectLead")

  @@index([organizationId])
  @@index([icpProfileId])
  @@index([campaignId])
  @@index([status])
  @@index([externalType, externalId])
  @@map("lead")
  @@schema("sales")
}

model TableColumn {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  createdById    Int      @map("created_by_id")
  tableName      String   @map("table_name")
  columnKey      String   @map("column_key")
  label          String
  fieldType      String   @map("field_type")
  isRequired     Boolean  @default(false) @map("is_required")
  config         Json     @default("{}") @map("config")
  createdAt      DateTime @default(now()) @map("created_at")

  organization   Organization @relation("OrganizationTableColumns", fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("CreatedTableColumns", fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([organizationId, tableName, columnKey])

  @@index([organizationId])
  @@index([tableName])
  @@index([organizationId, tableName])

  @@map("table_column")
  @@schema("sales")
}


// ============================================
// PROSPECT LIFECYCLE
// See docs/concepts/prospect-lifecycle.mdx — states and transitions are
// defined in libs/sales/src/lib/constants/prospects.ts.
// ============================================

model Prospect {
  id             Int     @id @default(autoincrement())
  organizationId Int     @map("organization_id")
  icpProfileId   Int?    @map("icp_profile_id")
  // Set when identity resolution matched someone we already know. The contact
  // stays the source of truth for who they are; the prospect holds only
  // outbound state, so an existing customer is never duplicated as a new lead.
  contactId      Int?    @map("contact_id")
  // Set on promotion. Its presence is what makes the status `promoted`.
  leadId         Int?    @unique @map("lead_id")

  name           String
  email          String?
  phone          String?
  companyName    String? @map("company_name")
  title          String?
  linkedinUrl    String? @map("linkedin_url")

  // External system identity. externalType names the system (apollo | origami |
  // salesforce | ...), externalId is who they are in it. See
  // docs/concepts/external-identity.mdx.
  externalType String? @map("external_type")
  externalId   String? @map("external_id")

  status String @default("new")
  source String @default("manual")

  // Per-channel consent: unknown | granted | revoked. Outbound is opt-out, so
  // `unknown` is contactable and only `revoked` silences a channel.
  emailConsent    String @default("unknown") @map("email_consent")
  linkedinConsent String @default("unknown") @map("linkedin_consent")
  phoneConsent    String @default("unknown") @map("phone_consent")

  fields   Json  @default("{}")
  notes    Json?
  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization         @relation("OrganizationProspects", fields: [organizationId], references: [id], onDelete: Cascade)
  icpProfile   IcpProfile?          @relation("IcpProspects", fields: [icpProfileId], references: [id], onDelete: SetNull)
  contact      Contact?             @relation("ContactProspects", fields: [contactId], references: [id], onDelete: SetNull)
  lead         Lead?                @relation("ProspectLead", fields: [leadId], references: [id], onDelete: SetNull)
  memberships  CampaignMembership[] @relation("ProspectMemberships")
  events       CampaignEvent[]      @relation("ProspectEvents")

  // Identity resolution keys — one human, one prospect, per organization.
  @@unique([organizationId, email])
  @@unique([organizationId, externalType, externalId])
  @@unique([organizationId, linkedinUrl])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([icpProfileId])
  @@index([contactId])
  @@map("prospect")
  @@schema("sales")
}

model CampaignMembership {
  id         Int @id @default(autoincrement())
  prospectId Int @map("prospect_id")
  campaignId Int @map("campaign_id")

  // The three independent axes. `disposition` stays null until the membership
  // closes; a terminal state without one is invalid.
  state       String  @default("identified")
  engagement  String  @default("not_contacted")
  disposition String?

  // Which channel this campaign reaches them on. Consent is per channel, so a
  // membership is bound to one.
  channel String @default("email")

  enrolledAt DateTime? @map("enrolled_at")
  closedAt   DateTime? @map("closed_at")
  // When this prospect may be approached again after this membership closed:
  // the no-response cooldown, or the date a "not now" reply asked us to wait for.
  nextEligibleAt DateTime? @map("next_eligible_at")
  metadata       Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  prospect Prospect        @relation("ProspectMemberships", fields: [prospectId], references: [id], onDelete: Cascade)
  campaign Campaign        @relation("CampaignMemberships", fields: [campaignId], references: [id], onDelete: Cascade)
  events   CampaignEvent[] @relation("MembershipEvents")

  // At most one OPEN membership per prospect per campaign is enforced by a
  // partial unique index (see migration) — closed ones may repeat on re-enrolment.
  @@index([prospectId])
  @@index([campaignId])
  @@index([campaignId, state])
  @@index([state])
  @@index([engagement])
  @@index([nextEligibleAt])
  @@map("campaign_membership")
  @@schema("sales")
}

model CampaignEvent {
  id           Int @id @default(autoincrement())
  membershipId Int @map("membership_id")
  prospectId   Int @map("prospect_id")

  eventType  String   @map("event_type")
  occurredAt DateTime @map("occurred_at")
  payload    Json?
  // Provider event id — makes webhook replay idempotent.
  externalId String?  @map("external_id")

  // Audit: who caused this, and through what. `actorId` is null for events the
  // provider or a scheduler raised; source is one of
  // system | user | agent | provider.
  actorId Int?   @map("actor_id")
  source  String @default("system")

  createdAt DateTime @default(now()) @map("created_at")

  membership CampaignMembership @relation("MembershipEvents", fields: [membershipId], references: [id], onDelete: Cascade)
  prospect   Prospect           @relation("ProspectEvents", fields: [prospectId], references: [id], onDelete: Cascade)

  @@unique([membershipId, externalId])
  @@index([membershipId, occurredAt])
  @@index([actorId])
  @@index([prospectId, occurredAt])
  @@index([eventType])
  @@map("campaign_event")
  @@schema("sales")
}

// ============================================
// SALES MODELS
// ============================================

model Contact {
  id             Int          @id @default(autoincrement())
  organizationId Int          @map("organization_id")
  name           String
  email          String?
  phone          String? // E.164 format (e.g., +14155552671)
  linkedinId     String?      @map("linkedin_id")
  notes          Json?        @map("notes")
  fields         Json         @default("{}") @map("fields")
  isHidden       Boolean      @default(false) @map("is_hidden")
  apolloPersonId  String?     @map("apollo_person_id") // Apollo global person ID (stable across workspaces)
  apolloContactId String?     @map("apollo_contact_id") // Apollo workspace contact ID (exists once saved/enrolled in Apollo)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation("OrganizationContacts", fields: [organizationId], references: [id], onDelete: Cascade)
  owners         ContactOwner[]
  companyHistory CompanyContact[]
  deals          DealContact[]
  leads          Lead[]       @relation("ContactLeads")

  @@index([organizationId])
  @@index([isHidden])
  @@index([email])
  @@index([phone])
  @@index([linkedinId])
  @@index([apolloPersonId])
  @@index([apolloContactId])
  @@map("contact")
  @@schema("sales")
}

model ContactOwner {
  id         Int      @id @default(autoincrement())
  contactId  Int      @map("contact_id")
  userId     Int      @map("user_id")
  isPrimary  Boolean  @default(false) @map("is_primary")
  assignedAt DateTime @default(now()) @map("assigned_at")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contactId, userId])
  @@index([userId])
  @@index([contactId])
  @@map("contact_owner")
  @@schema("sales")
}

model Activity {
  id           Int      @id @default(autoincrement())
  activityType String   @map("activity_type") // 'comment' | 'field_update' | 'status_change' | 'assignment' | etc.
  entityType   String   @map("entity_type") // 'contact' | 'company' | 'deal'
  entityId     Int      @map("entity_id") // ID of the contact/company/deal
  actorId      Int?     @map("actor_id") // null for system events
  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  content      String?  @db.Text // For comments
  metadata     Json? // Flexible data for different activity types
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([entityType, entityId, createdAt])
  @@index([actorId])
  @@index([activityType])
  @@map("activity")
  @@schema("sales")
}

model Company {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  companyName    String   @map("company_name")
  website        String?
  linkedinUrl    String?  @map("linkedin_url")
  summary        Json?    @map("summary")
  isHidden       Boolean  @default(false) @map("is_hidden")
  fields         Json     @default("{}") @map("fields")
  apolloOrganizationId String? @map("apollo_organization_id") // Apollo global organization ID (stable across workspaces)
  apolloAccountId      String? @map("apollo_account_id") // Apollo workspace account ID (exists once saved to Apollo)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  organization Organization @relation("OrganizationCompanies", fields: [organizationId], references: [id], onDelete: Cascade)
  contacts    CompanyContact[]
  owners      CompanyOwner[]
  deals       DealCompany[]

  @@index([organizationId])
  @@index([isHidden])
  @@index([companyName])
  @@index([apolloOrganizationId])
  @@index([apolloAccountId])
  @@map("company")
  @@schema("sales")
}

model CompanyContact {
  id        Int       @id @default(autoincrement())
  companyId Int       @map("company_id")
  contactId Int       @map("contact_id")
  joinedAt  DateTime  @default(now()) @map("joined_at")
  leftAt    DateTime? @map("left_at")
  role      String? // e.g., "employee", "contractor", "advisor"
  isPrimary Boolean   @default(false) @map("is_primary") // primary employer
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([contactId])
  @@index([leftAt])
  @@map("company_contact")
  @@schema("sales")
}

model CompanyOwner {
  id         Int      @id @default(autoincrement())
  companyId  Int      @map("company_id")
  userId     Int      @map("user_id")
  isPrimary  Boolean  @default(false) @map("is_primary")
  assignedAt DateTime @default(now()) @map("assigned_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
  @@index([companyId])
  @@map("company_owner")
  @@schema("sales")
}

model Deal {
  id                Int       @id @default(autoincrement())
  organizationId    Int       @map("organization_id")
  title             String
  value             Decimal?  @db.Decimal(15, 2)
  currency          String?   @default("USD")
  probability       Int?      @default(50)
  stage             String    @default("prospecting")
  summary           Json?     @map("summary")
  expectedCloseDate DateTime? @map("expected_close_date")
  actualCloseDate   DateTime? @map("actual_close_date")
  lostReason        String?   @map("lost_reason")
  source            String?
  priority          Int?      @default(2)
  isHidden          Boolean   @default(false) @map("is_hidden")
  fields            Json      @default("{}") @map("fields")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  organization Organization @relation("OrganizationDeals", fields: [organizationId], references: [id], onDelete: Cascade)
  companies    DealCompany[]
  contacts     DealContact[]
  owners       DealOwner[]
  leads        Lead[]       @relation("DealLeads")

  @@index([organizationId])
  @@index([isHidden])
  @@index([stage])
  @@index([expectedCloseDate])
  @@index([actualCloseDate])
  @@index([createdAt])
  @@map("deal")
  @@schema("sales")
}

model DealCompany {
  id        Int      @id @default(autoincrement())
  dealId    Int      @map("deal_id")
  companyId Int      @map("company_id")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  deal    Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([dealId, companyId])
  @@index([dealId])
  @@index([companyId])
  @@map("deal_company")
  @@schema("sales")
}

model DealContact {
  id        Int      @id @default(autoincrement())
  dealId    Int      @map("deal_id")
  contactId Int      @map("contact_id")
  role      String?
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  deal    Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([dealId, contactId])
  @@index([dealId])
  @@index([contactId])
  @@index([role])
  @@map("deal_contact")
  @@schema("sales")
}

model DealOwner {
  id         Int      @id @default(autoincrement())
  dealId     Int      @map("deal_id")
  userId     Int      @map("user_id")
  isPrimary  Boolean  @default(false) @map("is_primary")
  assignedAt DateTime @default(now()) @map("assigned_at")

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dealId, userId])
  @@index([userId])
  @@index([dealId])
  @@map("deal_owner")
  @@schema("sales")
}

model IcpProfile {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  name           String
  description    Json?    @map("description")
  filters        Json     @default("{}") @map("filters")
  notes          Json?    @map("notes")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation("OrganizationIcpProfiles", fields: [organizationId], references: [id], onDelete: Cascade)
  campaigns    Campaign[]   @relation("IcpCampaigns")
  leads        Lead[]       @relation("IcpLeads")

  @@index([organizationId])
  @@map("icp_profile")
  @@schema("sales")
}

model Campaign {
  id                 Int      @id @default(autoincrement())
  organizationId     Int      @map("organization_id")
  createdById        Int      @map("created_by_id")
  icpProfileId       Int?     @map("icp_profile_id")
  name               String
  provider           String   @default("apollo")
  platform           String   @default("apollo")
  providerSequenceId String?  @map("provider_sequence_id")
  active             Boolean  @default(false)
  permissions        String   @default("team_can_use")
  sequence           Json     @default("[]")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization Organization @relation("OrganizationCampaigns", fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("CreatedCampaigns", fields: [createdById], references: [id])
  icpProfile   IcpProfile?  @relation("IcpCampaigns", fields: [icpProfileId], references: [id], onDelete: SetNull)
  leads        Lead[]       @relation("CampaignLeads")

  @@unique([organizationId, providerSequenceId])
  @@index([organizationId])
  @@index([icpProfileId])
  @@map("campaign")
  @@schema("sales")
}

model Lead {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  icpProfileId   Int      @map("icp_profile_id")
  campaignId     Int?     @map("campaign_id")
  contactId      Int?     @map("contact_id")
  dealId         Int?     @map("deal_id")
  name           String
  email          String?
  phone          String?
  companyName    String?  @map("company_name")
  title          String?
  linkedinUrl    String?  @map("linkedin_url")
  status         String   @default("replied")
  source         String   @default("manual")
  apolloPersonId String?  @map("apollo_person_id")
  notes          Json?
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation("OrganizationLeads", fields: [organizationId], references: [id], onDelete: Cascade)
  icpProfile   IcpProfile   @relation("IcpLeads", fields: [icpProfileId], references: [id])
  campaign     Campaign?    @relation("CampaignLeads", fields: [campaignId], references: [id], onDelete: SetNull)
  contact      Contact?     @relation("ContactLeads", fields: [contactId], references: [id], onDelete: SetNull)
  deal         Deal?        @relation("DealLeads", fields: [dealId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([icpProfileId])
  @@index([campaignId])
  @@index([status])
  @@map("lead")
  @@schema("sales")
}

model TableColumn {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  createdById    Int      @map("created_by_id")
  tableName      String   @map("table_name")
  columnKey      String   @map("column_key")
  label          String
  fieldType      String   @map("field_type")
  isRequired     Boolean  @default(false) @map("is_required")
  config         Json     @default("{}") @map("config")
  createdAt      DateTime @default(now()) @map("created_at")

  organization   Organization @relation("OrganizationTableColumns", fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("CreatedTableColumns", fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([organizationId, tableName, columnKey])

  @@index([organizationId])
  @@index([tableName])
  @@index([organizationId, tableName])

  @@map("table_column")
  @@schema("sales")
}

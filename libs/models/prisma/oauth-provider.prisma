// ============================================
// OAuth 2.1 Provider Tables (@better-auth/oauth-provider)
// ============================================
// Field names must match the plugin's schema exactly (camelCase, see
// `oauthProvider().schema`); column/table names follow repo convention.
// IDs are DB serials — better-auth runs with generateId: "serial" and the
// prisma adapter converts string<->Int at the API boundary (same pattern
// as Session/Account). clientId (the OAuth client_id string) is the
// plugin-generated identifier; relations reference it, not the serial id.

model OauthClient {
  id                      Int                 @id @default(autoincrement())
  clientId                String              @unique @map("client_id")
  clientSecret            String?             @map("client_secret")
  disabled                Boolean?            @default(false)
  skipConsent             Boolean?            @map("skip_consent")
  enableEndSession        Boolean?            @map("enable_end_session")
  subjectType             String?             @map("subject_type")
  scopes                  String[]
  userId                  Int?                @map("user_id")
  referenceId             String?             @map("reference_id")
  name                    String?
  uri                     String?
  icon                    String?
  contacts                String[]
  tos                     String?
  policy                  String?
  softwareId              String?             @map("software_id")
  softwareVersion         String?             @map("software_version")
  softwareStatement       String?             @map("software_statement")
  redirectUris            String[]            @map("redirect_uris")
  postLogoutRedirectUris  String[]            @map("post_logout_redirect_uris")
  tokenEndpointAuthMethod String?             @map("token_endpoint_auth_method")
  grantTypes              String[]            @map("grant_types")
  responseTypes           String[]            @map("response_types")
  public                  Boolean?
  type                    String?
  requirePKCE             Boolean?            @map("require_pkce")
  metadata                Json?
  createdAt               DateTime?           @default(now()) @map("created_at")
  updatedAt               DateTime?           @updatedAt @map("updated_at")

  user          User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens OauthRefreshToken[]
  accessTokens  OauthAccessToken[]
  consents      OauthConsent[]

  @@index([userId])
  @@map("oauth_clients")
  @@schema("public")
}

model OauthRefreshToken {
  id          Int       @id @default(autoincrement())
  token       String    @unique
  clientId    String    @map("client_id")
  sessionId   Int?      @map("session_id")
  userId      Int       @map("user_id")
  referenceId String?   @map("reference_id")
  scopes      String[]
  revoked     DateTime?
  authTime    DateTime? @map("auth_time")
  createdAt   DateTime  @default(now()) @map("created_at")
  expiresAt   DateTime  @map("expires_at")

  client       OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  session      Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokens OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@map("oauth_refresh_tokens")
  @@schema("public")
}

model OauthAccessToken {
  id          Int      @id @default(autoincrement())
  token       String   @unique
  clientId    String   @map("client_id")
  sessionId   Int?     @map("session_id")
  userId      Int?     @map("user_id")
  referenceId String?  @map("reference_id")
  refreshId   Int?     @map("refresh_id")
  scopes      String[]
  createdAt   DateTime @default(now()) @map("created_at")
  expiresAt   DateTime @map("expires_at")

  client       OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  session      Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user         User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([refreshId])
  @@map("oauth_access_tokens")
  @@schema("public")
}

model OauthConsent {
  id          Int      @id @default(autoincrement())
  clientId    String   @map("client_id")
  userId      Int      @map("user_id")
  referenceId String?  @map("reference_id")
  scopes      String[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  client OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@map("oauth_consents")
  @@schema("public")
}

// Signing keys for the jwt plugin (JWKS served at {basePath}/jwks).
// Required by @better-auth/oauth-provider for JWT access tokens.
model Jwks {
  id         Int       @id @default(autoincrement())
  publicKey  String    @map("public_key") @db.Text
  privateKey String    @map("private_key") @db.Text
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime? @map("expires_at")

  @@map("jwks")
  @@schema("public")
}

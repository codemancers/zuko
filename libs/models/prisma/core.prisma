// ============================================
// CORE MODELS
// ============================================

enum UserRole {
  none
  admin
  accountant

  @@schema("public")
}

model User {
  id                     Int                        @id @default(autoincrement())
  name                   String
  email                  String
  emailVerified          Boolean                    @default(false) @map("email_verified")
  image                  String?
  role                   UserRole                   @default(none)
  createdAt              DateTime                   @default(now()) @map("created_at")
  updatedAt              DateTime                   @updatedAt @map("updated_at")
  sessions               Session[]
  accounts               Account[]
  contactOwners          ContactOwner[]
  companyOwners          CompanyOwner[]
  dealOwners             DealOwner[]
  activities             Activity[]
  createdChats           Chat[]                     @relation("ChatCreator")
  chatParticipations     ChatParticipant[]
  members                Member[]
  invitations            Invitation[]
  createdTableColumns    TableColumn[]              @relation("CreatedTableColumns")
  createdCampaigns       Campaign[]                 @relation("CreatedCampaigns")
  teammembers            TeamMember[]
  taskOwners             TaskOwner[]
  meetings               Meeting[]
  agentHosts             AgentHost[]
  agents                 Agent[]
  approvalRequests       ApprovalRequest[]
  agentGrantsDenied      AgentCapabilityGrant[]     @relation("AgentGrantsDenied")
  agentGrantsGranted     AgentCapabilityGrant[]     @relation("AgentGrantsGranted")
  connections            Connection[]
  // OAuth 2.1 provider relations
  oauthClients           OauthClient[]
  oauthRefreshTokens     OauthRefreshToken[]
  oauthAccessTokens      OauthAccessToken[]
  oauthConsents          OauthConsent[]

  @@unique([email])
  @@map("user")
  @@schema("public")
}



model Session {
  id                   Int                  @id @default(autoincrement())
  expiresAt            DateTime             @map("expires_at")
  token                String
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  ipAddress            String?              @map("ip_address")
  userAgent            String?              @map("user_agent")
  userId               Int                  @map("user_id")
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?              @map("active_organization_id")
  activeTeamId         String?              @map("active_team_id")
  // OAuth 2.1 provider relations
  oauthRefreshTokens   OauthRefreshToken[]
  oauthAccessTokens    OauthAccessToken[]

  @@unique([token])
  @@index([userId])
  @@map("session")
  @@schema("public")
}

model Account {
  id                    Int       @id @default(autoincrement())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                Int       @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("account")
  @@schema("public")
}

model Verification {
  id         Int      @id @default(autoincrement())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
  @@schema("public")
}

model GithubApp {
  id             Int       @id @default(autoincrement())
  installationId Int       @unique @map("installation_id")
  accountLogin   String    @map("account_login")
  suspendedAt    DateTime? @map("suspended_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("github_app")
  @@schema("public")
}

enum ChatMessageRole {
  user
  assistant
  system

  @@schema("public")
}

model Chat {
  id          Int      @id @default(autoincrement())
  threadId    String   @unique @map("thread_id")
  title       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById Int      @map("created_by_id")
  agentId     Int?     @map("agent_id")

  createdBy    User              @relation("ChatCreator", fields: [createdById], references: [id], onDelete: Cascade)
  agent        Agent?            @relation(fields: [agentId], references: [id], onDelete: SetNull)
  participants ChatParticipant[]
  sandboxes    Sandbox[]
  messages     ChatMessage[]

  @@index([agentId])
  @@map("chat")
  @@schema("public")
}

model ChatMessage {
  id        String          @id
  chatId    Int             @map("chat_id")
  role      ChatMessageRole
  parts     Json
  metadata  Json?
  createdAt DateTime        @default(now()) @map("created_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@map("chat_message")
  @@schema("public")
}

model ChatParticipant {
  id       Int      @id @default(autoincrement())
  chatId   Int      @map("chat_id")
  userId   Int      @map("user_id")
  joinedAt DateTime @default(now()) @map("joined_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([userId])
  @@map("chat_participant")
  @@schema("public")
}


model Organization {
  id          Int            @id @default(autoincrement())
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]
  teams       Team[]

  contacts            Contact[]            @relation("OrganizationContacts")
  companies           Company[]            @relation("OrganizationCompanies")
  deals               Deal[]               @relation("OrganizationDeals")
  tableColumns        TableColumn[]        @relation("OrganizationTableColumns")
  meetings            Meeting[]
  connections         Connection[]
  icpProfiles         IcpProfile[]         @relation("OrganizationIcpProfiles")
  campaigns           Campaign[]           @relation("OrganizationCampaigns")

  @@unique([slug])
  @@map("organization")
  @@schema("public")
}

model Connection {
  id             Int          @id @default(autoincrement())
  organizationId Int          @map("organization_id")
  provider       String
  // Tokens are managed by Nango; these columns are kept nullable for migration safety
  accessToken    String?      @map("access_token")
  refreshToken   String?      @map("refresh_token")
  tokenExpiresAt DateTime?    @map("token_expires_at")
  nangoConnectionId String?   @map("nango_connection_id")
  connectedById  Int          @map("connected_by_id")
  connectedAt    DateTime     @default(now()) @map("connected_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedBy  User         @relation(fields: [connectedById], references: [id])

  @@unique([organizationId, provider])
  @@index([organizationId])
  @@map("connection")
  @@schema("public")
}

model Member {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
  @@schema("public")

}

model Invitation {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      Int
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  teamId String?

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
  @@schema("public")

}

model Team {
  id             Int          @id @default(autoincrement())
  name           String
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime
  updatedAt      DateTime?    @updatedAt
  teammembers    TeamMember[]

  @@index([organizationId])
  @@map("team")
  @@schema("public")

}

model TeamMember {
  id        Int       @id @default(autoincrement())
  teamId    Int
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime?

  @@index([teamId])
  @@index([userId])
  @@map("teamMember")
  @@schema("public")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED

  @@schema("public")
}

model Task {
  id             Int        @id @default(autoincrement())
  organizationId Int        @map("organization_id")
  title          String
  description    Json?      @map("description")
  status         TaskStatus @default(TODO)
  completedAt    DateTime?  @map("completed_at")
  parentId       Int?       @map("parent_id")
  assignee       String?

  parent   Task?  @relation("TaskSubtasks", fields: [parentId], references: [id])
  subtasks Task[] @relation("TaskSubtasks")
  owners   TaskOwner[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([parentId])
  @@index([status])
  @@map("task")
  @@schema("public")
}

model TaskOwner {
  id         Int      @id @default(autoincrement())
  taskId     Int      @map("task_id")
  userId     Int      @map("user_id")
  isPrimary  Boolean  @default(false) @map("is_primary")
  assignedAt DateTime @default(now()) @map("assigned_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
  @@index([taskId])
  @@map("task_owner")
  @@schema("public")
}

enum SandboxLifecycleState {
  provisioning
  active
  hibernating
  hibernated
  restoring
  failed

  @@schema("public")
}

model Sandbox {
  id             Int                   @id @default(autoincrement())
  name           String                @unique
  url            String
  agentId        Int?                  @map("agent_id")
  lifecycleState SandboxLifecycleState @default(provisioning) @map("lifecycle_state")
  lifecycleError String?               @map("lifecycle_error")
  lastActivityAt DateTime?             @map("last_activity_at")
  hibernateAfter DateTime?             @map("hibernate_after")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  agent Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  chats Chat[]

  @@index([agentId])
  @@index([lifecycleState])
  @@index([hibernateAfter])
  @@map("sandbox")
  @@schema("public")
}


